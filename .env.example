# Banco de dados (SQLite no MVP; trocar por Postgres depois: provider no schema.prisma + esta URL)
DATABASE_URL="file:./dev.db"

# Provedor de IA ativo: anthropic | gemini | mock
#  - gemini: usa o endpoint compatível com OpenAI do Google AI Studio (free tier p/ testar)
#  - anthropic: SDK oficial (produção)
#  - mock: respostas simuladas em código, sem custo (o mesmo que ANTHROPIC_MOCK=1)
AI_PROVIDER=gemini

# Gemini (aistudio.google.com — gere a chave, sem cartão)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# Anthropic — usada quando AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Credenciais do nutricionista (admin). O seed cria/atualiza o admin com esta senha.
ADMIN_EMAIL="eudes@nutre.ai"
ADMIN_PASSWORD=""

# Segredo para assinar o cookie de sessao do admin (gere um valor aleatorio longo)
SESSION_SECRET=""

# URL base do app (usada para montar links magicos dos clientes)
APP_URL="http://localhost:3000"
